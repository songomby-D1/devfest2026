# Root environment for the local Compose stack (INFRA-01).
# `npm run setup:env` copies this file to `.env`, which Git ignores, and fills every empty
# secret with a random value. Existing values are never replaced. Never commit real values.

# --- Shared PostgreSQL (D04) ---
POSTGRES_USER=lova
POSTGRES_PASSWORD=

# One database per stateful service, owned by its migration role, with a runtime role
# limited to data access. Remove a block's DB_NAME to skip that service.
AUTH_DB_NAME=auth
AUTH_MIGRATION_DB_USER=auth_migrator
AUTH_MIGRATION_DB_PASSWORD=
AUTH_RUNTIME_DB_USER=auth_runtime
AUTH_RUNTIME_DB_PASSWORD=

CONTENT_DB_NAME=content
CONTENT_MIGRATION_DB_USER=content_migrator
CONTENT_MIGRATION_DB_PASSWORD=
CONTENT_RUNTIME_DB_USER=content_runtime
CONTENT_RUNTIME_DB_PASSWORD=

NFT_DB_NAME=nft
NFT_MIGRATION_DB_USER=nft_migrator
NFT_MIGRATION_DB_PASSWORD=
NFT_RUNTIME_DB_USER=nft_runtime
NFT_RUNTIME_DB_PASSWORD=

LIDAR_DB_NAME=lidar
LIDAR_MIGRATION_DB_USER=lidar_migrator
LIDAR_MIGRATION_DB_PASSWORD=
LIDAR_RUNTIME_DB_USER=lidar_runtime
LIDAR_RUNTIME_DB_PASSWORD=

# --- SeaweedFS S3-compatible storage (D05) ---
S3_MEDIA_BUCKET=lova-media
S3_MODELS_BUCKET=lova-models
SEAWEEDFS_ADMIN_ACCESS_KEY=
SEAWEEDFS_ADMIN_SECRET_KEY=
SEAWEEDFS_CONTENT_ACCESS_KEY=
SEAWEEDFS_CONTENT_SECRET_KEY=
SEAWEEDFS_LIDAR_ACCESS_KEY=
SEAWEEDFS_LIDAR_SECRET_KEY=

# --- Service-to-service secrets, one per caller and receiver pair (D07) ---
SERVICE_TOKEN_GATEWAY_TO_AUTH=
SERVICE_TOKEN_GATEWAY_TO_CONTENT=
SERVICE_TOKEN_GATEWAY_TO_NFT=
SERVICE_TOKEN_GATEWAY_TO_LIDAR=
SERVICE_TOKEN_NFT_TO_CONTENT=
SERVICE_TOKEN_LIDAR_TO_CONTENT=

# --- Gateway (D06) ---
# Operator token for /api/admin routes, such as granting the reviewer permission.
GATEWAY_ADMIN_TOKEN=
# Browser origins allowed to call the gateway, comma-separated. Add the phone's LAN origin
# for mobile QA, for example http://192.168.1.20:5173.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use 0.0.0.0 to reach the gateway from a second device on the local network.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=3000
# true only behind HTTPS: switches to the __Host- cookie with the Secure flag.
SESSION_COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=104857600
