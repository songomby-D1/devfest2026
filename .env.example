# Root Compose variables. Copy to .env and replace every placeholder; never commit .env.

# PROVISIONAL PostgreSQL superuser until INFRA-01 provides the shared instance.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me

# LiDAR database and roles (D04). Use URL-safe characters in passwords: they are embedded in connection URLs.
LIDAR_DB_NAME=lidar
LIDAR_MIGRATION_DB_USER=lidar_migrator
LIDAR_MIGRATION_DB_PASSWORD=replace-me
LIDAR_RUNTIME_DB_USER=lidar_runtime
LIDAR_RUNTIME_DB_PASSWORD=replace-me

# LiDAR service. LIDAR_ADMIN_TOKEN needs at least 32 characters (for example `openssl rand -hex 32`).
LIDAR_ADMIN_TOKEN=replace-me
LIDAR_CONTENT_SERVICE_URL=http://content:3000
LIDAR_PUBLIC_ASSET_BASE_PATH=/api/lidar/files
LIDAR_HOST_PORT=3004
