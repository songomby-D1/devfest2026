{
  "name": "devfest2026",
  "private": true,
  "description": "LOVA, the participatory digital museum of Malagasy heritage.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12 <23"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run prisma:generate --workspaces --if-present --silent && eslint . --max-warnings 0",
    "format": "prettier --config .prettierrc.json --write .",
    "format:check": "prettier --config .prettierrc.json --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "setup:env": "node scripts/setup/init-env.mjs",
    "compose:config": "docker compose config --quiet",
    "smoke:auth": "node scripts/testing/auth-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
