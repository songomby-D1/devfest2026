{
  "name": "nft-service",
  "version": "0.0.0",
  "private": true,
  "description": "LOVA NFT service: preservation certificates on Avalanche Fuji",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "npm run contract:compile && tsc --noEmit -p tsconfig.json && tsc --noEmit -p hardhat/tsconfig.json",
    "test": "jest && npm run contract:test",
    "test:service": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --testPathPattern=test/http",
    "contract:compile": "hardhat --config hardhat/hardhat.config.ts compile",
    "contract:test": "hardhat --config hardhat/hardhat.config.ts test",
    "contract:coverage": "hardhat --config hardhat/hardhat.config.ts coverage",
    "contract:node": "hardhat --config hardhat/hardhat.config.ts node --hostname 0.0.0.0",
    "contract:deploy:local": "hardhat --config hardhat/hardhat.config.ts run hardhat/scripts/deploy.ts --network localhost",
    "contract:deploy:fuji": "hardhat --config hardhat/hardhat.config.ts run hardhat/scripts/deploy.ts --network fuji",
    "contract:verify:fuji": "hardhat --config hardhat/hardhat.config.ts verify --network fuji",
    "abi:export": "hardhat --config hardhat/hardhat.config.ts run hardhat/scripts/export-abi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@openzeppelin/contracts": "5.6.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "hardhat": "2.29.2",
    "jest": "29.7.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
