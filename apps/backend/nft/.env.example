# NFT service configuration (nft_context.md §9.8 and appendix A).
# Copy this file to apps/backend/nft/.env, which Git ignores, and fill the
# secrets yourself. Never commit real values.
# Redis variables join this file with the mint queue (lot L6).

# --- General ---
NODE_ENV=development
PORT=3005

# --- Files ---
# Absolute path to an existing directory. Docker Compose mounts it.
MEDIA_ROOT=/data/media

# --- Blockchain (Avalanche Fuji) ---
CHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
CONTRACT_ADDRESS=
MINTER_PRIVATE_KEY=
EXPLORER_BASE_URL=https://testnet.snowtrace.io
TX_TIMEOUT_MS=120000
LOW_BALANCE_AVAX=0.5
MINT_MAX_STALLED_COUNT=3

# --- IPFS (Pinata) ---
# Use "fake" for local work without a Pinata account. Forbidden in production.
IPFS_DRIVER=pinata
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_TIMEOUT_MS=600000

# --- Size limits (bytes) ---
MAX_MASTER_BYTES=2147483648
MAX_IMAGE_BYTES=20971520
MAX_GLB_BYTES=52428800
MAX_VIDEO_BYTES=104857600
MAX_PREVIEW_BYTES=5242880

# --- Development ---
BULL_BOARD_ENABLED=false

# --- Content & Verification (NFT-02) ---
# Publication lookup before a mint: GET /internal/v1/items/{id}/publication.
CONTENT_SERVICE_URL=http://content:3000
# Secret of the NFT -> Content pair. Must equal Content's
# CONTENT_INBOUND_TOKEN_NFT (root .env: SERVICE_TOKEN_NFT_TO_CONTENT).
# At least 32 random characters; required when NODE_ENV=production.
CONTENT_SERVICE_TOKEN=
CONTENT_TIMEOUT_MS=3000

# --- Mint journey (NFT-04) ---
# Runtime role of the NFT database (D04). Docker Compose builds it from the
# root .env (compose.fragment.yml). The migration role only reaches the
# entrypoint, as MIGRATION_DATABASE_URL.
DATABASE_URL=
# Secret of the gateway -> NFT pair (root .env: SERVICE_TOKEN_GATEWAY_TO_NFT).
# At least 32 random characters; required when NODE_ENV=production.
NFT_INBOUND_TOKEN_GATEWAY=
# Processing attempts before a mint fails on transient errors.
MINT_MAX_ATTEMPTS=5
# Period of the sweep that resumes pending mints, in ms. 0 disables it.
MINT_SWEEP_INTERVAL_MS=30000
