# Content service configuration when run outside Compose.
# Copy to apps/backend/content/.env (ignored by Git) and fill in the secrets.
# Never commit real values.

PORT=3000

# Runtime role: data access only (D04).
DATABASE_URL=postgresql://content_runtime:replace-me@localhost:5432/content
# Migration role, used only by `prisma migrate deploy` (docker-entrypoint.sh).
MIGRATION_DATABASE_URL=postgresql://content_migrator:replace-me@localhost:5432/content

# Inbound service secrets, one per allowed caller (Auth contract), at least
# 32 characters each, for example `openssl rand -hex 32`. The gateway secret
# is required. A caller whose secret is empty is refused.
CONTENT_INBOUND_TOKEN_GATEWAY=
CONTENT_INBOUND_TOKEN_NFT=
CONTENT_INBOUND_TOKEN_LIDAR=
