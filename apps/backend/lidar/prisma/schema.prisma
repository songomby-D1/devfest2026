generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  pending
  ready
}

model Asset3d {
  id          String      @id @default(uuid()) @db.Uuid
  contentId   String      @unique
  objectKey1k String
  objectKey2k String
  posterKey   String
  usdzKey     String?
  size1kBytes Int
  size2kBytes Int
  posterBytes Int
  status      AssetStatus @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
