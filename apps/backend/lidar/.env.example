# Variables read by the LiDAR service when run outside Compose. Never commit a real .env.
PORT=3000
# Runtime role: data access only (D04).
DATABASE_URL=postgresql://lidar_runtime:replace-me@localhost:5432/lidar
# Migration role, used only by `prisma migrate deploy`.
MIGRATION_DATABASE_URL=postgresql://lidar_migrator:replace-me@localhost:5432/lidar
CONTENT_SERVICE_URL=http://localhost:3002
PUBLIC_ASSET_BASE_PATH=/api/lidar/files
# At least 32 characters, for example `openssl rand -hex 32`.
LIDAR_ADMIN_TOKEN=replace-me
# Optional image-to-3D generation (Meshy). Both values are needed to enable it.
MESHY_API_KEY=
# The gateway's LIDAR_SERVICE_TOKEN, at least 32 characters.
LIDAR_INBOUND_TOKEN_GATEWAY=
