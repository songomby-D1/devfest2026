{
  "name": "@devfest2026/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "LOVA API gateway: routing, sessions, caller context and public errors.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
