# Gateway (apps/backend/gateway). Compose derives these values from the root .env;
# copy this file to .env only to run the gateway outside Compose. Never commit real values.
PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
CONTENT_SERVICE_URL=http://localhost:3002
NFT_SERVICE_URL=http://localhost:3005
LIDAR_SERVICE_URL=http://localhost:3004
# One secret per receiving service, at least 32 characters each.
AUTH_SERVICE_TOKEN=
CONTENT_SERVICE_TOKEN=
NFT_SERVICE_TOKEN=
LIDAR_SERVICE_TOKEN=
# Operator token for /api/admin routes.
GATEWAY_ADMIN_TOKEN=
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_SECONDS=604800
UPSTREAM_TIMEOUT_MS=5000
AUTH_TIMEOUT_MS=8000
UPLOAD_TIMEOUT_MS=120000
MAX_UPLOAD_BYTES=104857600
AUTH_RATE_LIMIT_PER_MINUTE=10
