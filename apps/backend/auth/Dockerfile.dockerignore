# Build context is the repository root (D14). Keep only the root manifests, every workspace
# manifest that the root lockfile references, the shared types and this service.
*
!package.json
!package-lock.json
!.npmrc
!tsconfig.base.json
!apps/frontend/package.json
!apps/backend/*/package.json
!packages/*/package.json
!packages/shared/
!apps/backend/auth/

**/node_modules
**/dist
**/coverage
**/.env
**/.env.*
apps/backend/auth/src/generated
apps/backend/auth/test
apps/backend/auth/**/*.spec.ts
apps/backend/auth/vitest.config.ts
apps/backend/auth/Dockerfile*
packages/shared/test
