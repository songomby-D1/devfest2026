# Auth service (apps/backend/auth). Compose derives these values from the root .env;
# copy this file to .env only to run the service outside Compose. Never commit real values.
PORT=3000
# Runtime role: data access only (D04).
DATABASE_URL=postgresql://auth_runtime:change-me@localhost:5432/auth
# Migration role: used by `prisma migrate deploy` before start, then dropped from the env.
MIGRATION_DATABASE_URL=postgresql://auth_migrator:change-me@localhost:5432/auth
# Shared with the gateway's AUTH_SERVICE_TOKEN. At least 32 characters.
AUTH_INBOUND_TOKEN_GATEWAY=
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_DAYS=7
PASSWORD_HASH_CONCURRENCY=4
PASSWORD_HASH_MAX_WAIT_MS=5000
