# Gateway base URL for the Vite dev server proxy (/api -> gateway).
# Read by vite.config.ts only. It has no VITE_ prefix, so it is never exposed to the browser.
GATEWAY_URL=http://localhost:3000

# `mock` serves the Gate 0 contract fixtures from src/lib/api/fixtures.ts instead of calling the gateway.
# Leave it unset to call the gateway through /api.
VITE_API_MODE=mock
